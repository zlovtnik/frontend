# Production Environment Variables
# These values are used when building for production deployment
# Override these in your hosting platform's environment variables

# Backend API URL - MUST be set in hosting platform
VITE_API_URL=https://backend-5lgs.onrender.com/api

# Application name
VITE_APP_NAME=Dispo Rusty

# Environment
NODE_ENV=production

# Keycloak OAuth2 Configuration
# ⚠️ WARNING: The VITE_KEYCLOAK_ISSUER_URL below uses HTTP and an IP address.
# This is a TEMPORARY STAGING configuration and MUST be replaced before production release.
# For production, use a secure HTTPS URL with a valid domain and TLS certificate:
# Example: VITE_KEYCLOAK_ISSUER_URL=https://auth.yourdomain.com/realms/your-realm
# Ensure the Keycloak instance is behind a reverse proxy (e.g., nginx) with proper TLS.
VITE_KEYCLOAK_ISSUER_URL=http://147.224.156.139:8080/realms/master
VITE_KEYCLOAK_CLIENT_ID=middleware-app
VITE_KEYCLOAK_REDIRECT_URL=https://frontend-21iq.onrender.com/auth/callback
VITE_USE_KEYCLOAK_OAUTH=true