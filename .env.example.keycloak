# Frontend Environment Configuration Example
# Copy this to .env and update values for your environment

# API Configuration
VITE_API_URL=http://localhost:8000/api

# Application Name
VITE_APP_NAME=Actix Web REST API

# JWT Storage
VITE_JWT_STORAGE_KEY=auth_token

# Debug Mode
VITE_DEBUG=false

# Feature: Pwned Password Check
# Checks if password appears in public breach databases (production only)
VITE_ENABLE_PWNED_PASSWORD_CHECK=false

# Keycloak OAuth2 Configuration
# These are OPTIONAL - if not set, only direct login is available
# If VITE_KEYCLOAK_ISSUER_URL and VITE_KEYCLOAK_CLIENT_ID are set,
# a "Sign In with Keycloak" button will appear on the login page

# Keycloak Realm Issuer URL
# Examples:
#   - Local: http://localhost:8180/realms/master
#   - Railway: https://keycloak-production-xxx.up.railway.app/realms/master
#   - AWS: https://keycloak.example.com/realms/production
VITE_KEYCLOAK_ISSUER_URL=http://localhost:8180/realms/master

# Keycloak OAuth Client ID
# This is the client_id created in Keycloak admin console
# Example: middleware-app
VITE_KEYCLOAK_CLIENT_ID=middleware-app

# Keycloak Redirect URL
# This must match exactly what's configured in Keycloak:
#   Clients > {client_id} > Settings > Valid Redirect URIs
# Example: http://localhost:3000/auth/callback
VITE_KEYCLOAK_REDIRECT_URL=http://localhost:3000/auth/callback

# Default Country for Address Book / Data Initialization
VITE_DEFAULT_COUNTRY=

# Development Environment Detection
# (Set automatically by Vite based on npm scripts)
# NODE_ENV=development

